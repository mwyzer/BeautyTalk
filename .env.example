# ===== Application =====
NODE_ENV=development
PORT=4000

# ===== Database (docker-compose defaults) =====
DATABASE_URL=postgres://beautyai:beautyai_dev@localhost:5432/beautyai
DATABASE_URL_TEST=postgres://beautyai:beautyai_dev@localhost:5432/beautyai_test

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== Object storage (MinIO; S3-compatible) =====
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=beautyai_minio
S3_SECRET_KEY=beautyai_minio_secret
S3_BUCKET=beautyai-assets
S3_REGION=us-east-1

# ===== Auth =====
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=dev_access_secret_change_me_32_bytes_long
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_32_bytes_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ===== Stripe (Phase 1 checkout) =====
# Get test keys at https://dashboard.stripe.com/test/apikeys
# For local webhook testing: stripe listen --forward-to localhost:4000/api/v1/webhooks/stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Store URLs for Stripe redirects after payment
CHECKOUT_SUCCESS_URL=http://localhost:4321/checkout/confirm/{CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=http://localhost:4321/cart
STOREFRONT_URL=http://localhost:4321