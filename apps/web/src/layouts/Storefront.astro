---
import "../styles/storefront.css";
import CartDrawer from "../components/CartDrawer.tsx";
import { fetchCollections } from "../lib/api";
import type { CollectionSummary } from "@beautyai/shared";

const collections = await fetchCollections().catch(() => [] as CollectionSummary[]);

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "BeautyAI Store",
  description = "Clean, efficacious skincare crafted for modern routines.",
  canonical,
  ogTitle,
  ogDescription,
  ogImage,
  jsonLd,
} = Astro.props;

const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="theme-color" content="#faf6f0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {jsonLdItems.map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href="/">Beauty<em>Talk</em></a>
        <nav class="site-nav" aria-label="Store navigation">
          <a href="/">Home</a>
          {collections.map((c) => (
            <a href={`/collections/${c.handle}`}>{c.title}</a>
          ))}
          <a href="/search">Search</a>
          <a href="/account">Account</a>
        </nav>
        <div class="header-actions">
          <form class="search-form" action="/search" role="search">
            <input name="q" type="search" placeholder="Search skincare…" aria-label="Search" />
          </form>
          <button type="button" class="icon-btn" data-cart-open>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="9" cy="21" r="1" />
              <circle cx="20" cy="21" r="1" />
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
            </svg>
            <span data-cart-count class="cart-badge" hidden>0</span>
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container inner">
        <span>© {new Date().getFullYear()} BeautyTalk</span>
        <span>Efficacious skincare. Made honest.</span>
      </div>
    </footer>

    <CartDrawer client:load />
    <script is:inline>
      (function () {
        var existing = document.cookie.split("; ").some(function (r) { return r.indexOf("bt_sid=") === 0; });
        if (existing) return;
        var sid = (window.crypto && "randomUUID" in window.crypto)
          ? window.crypto.randomUUID()
          : "s-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2);
        document.cookie = "bt_sid=" + sid + "; path=/; max-age=31536000; SameSite=Lax";
      })();
    </script>
    <script>
      document.querySelectorAll("[data-cart-open]").forEach((el) => {
        el.addEventListener("click", () => {
          document.dispatchEvent(new CustomEvent("cart:open"));
        });
      });
    </script>
  </body>
</html>